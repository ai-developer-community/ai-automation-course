# Settings for the course. Copy this file to .env and fill it in. Never commit .env.
#
# On Cloud Run everything signs in as the automations service account,
# including the writing model (Gemini on Vertex AI). No key for those.
# deploy.sh puts the secrets below in Secret Manager. They never go in the code.

# Your Google Cloud project id, and the region everything runs in.
PROJECT=
REGION=europe-west2

# The model, and where it runs. "global" has every model. To pin where a customer's data is
# processed, set a region such as europe-west2, and check the model is offered there.
GEMINI_MODEL=gemini-3.8-flash
VERTEX_LOCATION=global

# The Google Sheet with "Prospects", "Leads" and "Hacker News" tabs. Share it with the service account as Editor.
# The id is the long part of the sheet's address.
SHEET_ID=

# Shadow mode: true does all the work and sends nothing. Set false to go live.
SHADOW=true

# The address speed to lead emails from, on a domain you've verified in Resend.
EMAIL_FROM=

# Secrets. deploy.sh copies each one into Secret Manager.
# 03_webhook checks this token. Make up a long random value.
WEBHOOK_TOKEN=
# 04_speed_to_lead checks requests are signed with this. Make up a long random value.
WEBHOOK_SECRET=
# A Slack incoming webhook address: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# An API key from resend.com.
RESEND_API_KEY=
# The decision model (Gemini Decisions API). For now it needs an API key from Google AI Studio:
# https://aistudio.google.com/apikey  Google Cloud doesn't have this API yet (it answered 404 on
# 14 November 2026). Once it does, leave this empty and the code signs in as the service account.
# With no key, speed to lead skips the decision step and still works. Hacker News needs it: the decision is its filter.
GEMINI_API_KEY=

# Optional: where tools/send_lead.py sends the test proposal. Use your own address.
TEST_LEAD_EMAIL=
